index 0000000..5135538
--- /dev/null
+++ b/lm_eval/models/codesense_batch.py
@@ -0,0 +1,81 @@
+"""CPU-only deterministic generation backend for replaying evaluation batches.
+
+Install the local harness checkout and select `--model codesense-batch`.
+Generation consumes UTF-8 bytes. Each output token indexes the repeatable
+alphabet below, allowing requests to be compared without a tokenizer download.
+"""
+
+from lm_eval.api.model import LM
+from lm_eval.api.registry import register_model
+from lm_eval.models.utils import Collator
+
+from llm_runtime import BatchEngine, Request, ToyModel
+
+
+_ALPHABET = "abcdefghijklmnopqrstuvwxyz01234"
+
+
+@register_model("codesense-batch")
+class CodesenseBatchLM(LM):
+    def __init__(
+        self, model="m1", tenant="local", adapter="", revision="1",
+        mode="packed", batch_size=64, engine=None,
+    ):
+        super().__init__()
+        self.model_name = model
+        self.tenant = tenant
+        self.adapter = adapter
+        self.revision = revision
+        self.mode = mode
+        self.replay_batch_size = int(batch_size)
+        if self.replay_batch_size < 1:
+            raise ValueError("batch_size must be positive")
+        self.engine = BatchEngine(models={model: ToyModel(model)}) if engine is None else engine
+
+    def generate_until(self, requests, disable_tqdm=False):
+        """Replay native (context, generation kwargs) pairs in scheduled batches."""
+        rows = []
+        for instance in requests:
+            context, options = instance.args
+            if not isinstance(context, str):
+                raise ValueError("generation requires a text context")
+            if options.get("do_sample", False):
+                raise ValueError("the replay backend supports deterministic generation only")
+            stops = options.get("until", ())
+            if isinstance(stops, str):
+                stops = (stops,)
+            if not isinstance(stops, (list, tuple)) or not all(isinstance(s, str) for s in stops):
+                raise ValueError("until must be a string or a sequence of strings")
+            request = Request(
+                tenant=self.tenant,
+                model=self.model_name,
+                adapter=self.adapter,
+                prompt=tuple(context.encode("utf-8")),
+                max_new_tokens=options.get("max_gen_toks", 4),
+                temperature=options.get("temperature", 0.0),
+                request_id=instance.idx,
+                min_new_tokens=options.get("min_new_tokens", 0),
+                eos_token_id=options.get("eos_token_id"),
+                context_length=options.get("context_length"),
+                seed=options.get("seed"),
+                shard=options.get("shard"),
+            )
+            rows.append((request, tuple(stops), instance.args))
+
+        batches = Collator(rows, sort_fn=lambda row: -len(row[0].prompt))
+        outputs = []
+        for batch in batches.get_batched(n=self.replay_batch_size):
+            raw = self.engine.generate_batch([row for row, _, _ in batch], mode=self.mode)
+            for tokens, (_, stops, args) in zip(raw, batch, strict=True):
+                text = "".join(_ALPHABET[token % len(_ALPHABET)] for token in tokens)
+                matches = [text.index(stop) for stop in stops if stop and stop in text]
+                reply = text[:min(matches)] if matches else text
+                self.cache_hook.add_partial("generate_until", args, reply)
+                outputs.append(reply)
+        return outputs
+
+    def loglikelihood(self, requests, disable_tqdm=False):
+        raise NotImplementedError("this replay backend only supports generate_until")
+
+    def loglikelihood_rolling(self, requests, disable_tqdm=False):
+        raise NotImplementedError("this replay backend only supports generate_until")
